# Optional higher-recall search providers. The no-key DuckDuckGo adapter remains available.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Optional synthesis provider. Without it, ProofPack uses its deterministic evidence scorer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional governed browser sidecar for JavaScript-heavy sources.
COCKROACH_BROWSER_ENDPOINT=
COCKROACH_BROWSER_TOKEN=

# Public deployment identity used in generated proof metadata.
PROOFPACK_PUBLIC_URL=http://localhost:3000

# ProofGate Track 3 integration. This key is server-only and must never use a
# NEXT_PUBLIC_ prefix. Fund its address with Base Sepolia USDC for x402 calls.
TELEGRAPH_NODE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_EVM_PRIVATE_KEY=
# Maximum per paid call in 6-decimal USDC units (50000 = $0.05).
# ProofGate rejects caps above 100000 ($0.10) as likely misconfiguration.
TELEGRAPH_MAX_PAYMENT_USDC_MICROS=50000
# Bound paid calls per preflight to 1-3. Lower caps can make strict multi-miner
# policies intentionally impossible to satisfy.
PROOFGATE_MAX_CALLS=3

# A configured payer remains locked until all three fields below are valid.
# Standard UPSTASH_REDIS_REST_* or KV_REST_API_* names are also accepted.
PROOFGATE_REDIS_REST_URL=
PROOFGATE_REDIS_REST_TOKEN=
# Comma-separated SHA-256 hashes only; never place raw tester keys here.
PROOFGATE_ACCESS_KEY_HASHES=
# Atomic worst-case reservations, measured in 6-decimal USDC units.
PROOFGATE_DAILY_BUDGET_USDC_MICROS=1000000
PROOFGATE_PRINCIPAL_MINUTE_LIMIT=2
PROOFGATE_PRINCIPAL_DAY_LIMIT=10
PROOFGATE_GLOBAL_CONCURRENCY=2
PROOFGATE_IDEMPOTENCY_TTL_SECONDS=86400
PROOFGATE_PENDING_TTL_SECONDS=180
