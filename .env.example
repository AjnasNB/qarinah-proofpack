# Optional higher-recall search providers. The no-key DuckDuckGo adapter remains available.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Optional synthesis provider. Without it, ProofPack uses its deterministic evidence scorer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional governed browser sidecar for JavaScript-heavy sources.
COCKROACH_BROWSER_ENDPOINT=
COCKROACH_BROWSER_TOKEN=

# Public deployment identity used in generated proof metadata.
PROOFPACK_PUBLIC_URL=http://localhost:3000
